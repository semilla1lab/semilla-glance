# Telegram (create a bot with @BotFather; add it to the groups you want on your glasses)
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed on the glasses (empty = all chats the bot sees)
GLANCE_ALLOW_CHATS=
# Optional fixed pairing code (otherwise a random one is printed at start)
GLANCE_PAIR_CODE=
PORT=8787

# LLM for drafts/digest/polish — any OpenAI-compatible endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Speech-to-text — any OpenAI-compatible /audio/transcriptions endpoint
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
